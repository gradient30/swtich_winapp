<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 暖炭 + 青绿开关色：工具感、克制、不「AI 紫」 -->
    <Color x:Key="BgDeep">#FF16181C</Color>
    <Color x:Key="BgPanel">#FF1E2228</Color>
    <Color x:Key="BgElevated">#FF262B33</Color>
    <Color x:Key="BgHover">#FF2E3540</Color>
    <Color x:Key="LineSubtle">#FF3A424E</Color>
    <Color x:Key="TextPrimary">#FFF2EFE8</Color>
    <Color x:Key="TextMuted">#FFA8B0BB</Color>
    <Color x:Key="Accent">#FF0D9488</Color>
    <Color x:Key="AccentSoft">#330D9488</Color>
    <Color x:Key="Danger">#FFE35D6A</Color>

    <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource BgDeep}" />
    <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource BgPanel}" />
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource BgElevated}" />
    <SolidColorBrush x:Key="BrushBgHover" Color="{StaticResource BgHover}" />
    <SolidColorBrush x:Key="BrushLineSubtle" Color="{StaticResource LineSubtle}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource AccentSoft}" />

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrushBgDeep}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="MenuBarStyle" TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="StatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushLineSubtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
</ResourceDictionary>
