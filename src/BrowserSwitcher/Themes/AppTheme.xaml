<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      默认暗色；明暗切换由 ThemeService 改写同名 Brush。
      一律用 DynamicResource，避免 Static 锁死颜色。
    -->
    <SolidColorBrush x:Key="BrushBgDeep" Color="#FF16181C" />
    <SolidColorBrush x:Key="BrushBgPanel" Color="#FF1E2228" />
    <SolidColorBrush x:Key="BrushBgElevated" Color="#FF262B33" />
    <SolidColorBrush x:Key="BrushBgHover" Color="#FF2E3540" />
    <SolidColorBrush x:Key="BrushLineSubtle" Color="#FF3A424E" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFF2EFE8" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#FFA8B0BB" />
    <SolidColorBrush x:Key="BrushAccent" Color="#FF0D9488" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#330D9488" />
    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFFFF" />

    <!-- 覆盖系统菜单色，避免「白底浅字 / 深字」 -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF262B33" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FF1E2228" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFF2EFE8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF0D9488" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFF2EFE8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF2EFE8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FFA8B0BB" />

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource BrushBgDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <!-- 默认正文色，避免 DataTemplate 内黑字落在深底上 -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BrushBgDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLineSubtle}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style x:Key="MenuBarStyle" TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}" />

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource BrushBgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLineSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource BrushBgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="StatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLineSubtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushLineSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
    </Style>
</ResourceDictionary>
