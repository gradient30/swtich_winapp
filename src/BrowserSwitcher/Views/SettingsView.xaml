<UserControl x:Class="BrowserSwitcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600"
             Background="{StaticResource BrushBgDeep}">
    <Border Background="{StaticResource BrushBgPanel}"
            BorderBrush="{StaticResource BrushLineSubtle}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right"
                        Content="返回"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackToMainCommand}" />
                <TextBlock Text="偏好设置"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>

            <DockPanel Grid.Row="1" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="手动路径"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap"
                               Text="编辑已保存路径；清空路径并保存即可删除。后续可在「设置」菜单继续扩展更多能力。" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ManualPathEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        Background="{StaticResource BrushBgElevated}"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBox Grid.Column="1"
                                                 Margin="8,0,8,0"
                                                 Padding="8,6"
                                                 Background="{StaticResource BrushBgDeep}"
                                                 Foreground="{StaticResource BrushTextPrimary}"
                                                 BorderBrush="{StaticResource BrushLineSubtle}"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding Path=Path,
                                                    UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2"
                                                Content="移除"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.RemoveManualPathCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Button Content="保存手动路径"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveManualPathsCommand}" />
                <CheckBox Margin="0,14,0,0"
                          Content="开机启动"
                          Foreground="{StaticResource BrushTextPrimary}"
                          IsChecked="{Binding StartWithWindows}" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="{StaticResource BrushTextMuted}"
                           Text="{Binding AppVersion, StringFormat=版本：{0}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
