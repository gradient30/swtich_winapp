<UserControl x:Class="BrowserSwitcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="480"
             d:DesignWidth="720">
    <!-- 半透明遮罩 + 居中紧凑卡片，避免整页空白 -->
    <Grid>
        <Border Background="#99000000"
                MouseLeftButtonDown="Dimmer_MouseLeftButtonDown" />

        <Border Width="440"
                MaxWidth="440"
                MaxHeight="520"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{DynamicResource BrushBgPanel}"
                BorderBrush="{DynamicResource BrushLineSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="0">
            <DockPanel>
                <!-- 标题栏 -->
                <Border DockPanel.Dock="Top"
                        Padding="16,12"
                        BorderBrush="{DynamicResource BrushLineSubtle}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="✕"
                                Width="32"
                                Height="28"
                                Padding="0"
                                ToolTip="关闭"
                                Style="{DynamicResource GhostButton}"
                                Command="{Binding BackToMainCommand}" />
                        <TextBlock Text="偏好设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- 底部操作 -->
                <Border DockPanel.Dock="Bottom"
                        Padding="16,12"
                        BorderBrush="{DynamicResource BrushLineSubtle}"
                        BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   FontSize="12"
                                   Text="{Binding AppVersion, StringFormat=v{0}}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="取消"
                                    Style="{DynamicResource GhostButton}"
                                    Margin="0,0,8,0"
                                    Command="{Binding BackToMainCommand}" />
                            <Button Content="保存"
                                    Style="{DynamicResource PrimaryButton}"
                                    Command="{Binding SaveManualPathsCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 正文：按内容收缩 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="16">
                    <StackPanel>
                        <!-- 开机启动 -->
                        <TextBlock Text="启动"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   Margin="0,0,0,8" />
                        <Border Background="{DynamicResource BrushBgElevated}"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,16">
                            <CheckBox Content="开机时自动启动"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding StartWithWindows}" />
                        </Border>

                        <!-- 一键直切（个人本地） -->
                        <TextBlock Text="默认浏览器"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   Margin="0,0,0,8" />
                        <Border Background="{DynamicResource BrushBgElevated}"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox Content="托盘一键直切（提权 + SetUserFTA）"
                                          IsChecked="{Binding ForceDirectSwitch}"
                                          Margin="0,0,0,8" />
                                <TextBlock Text="{Binding UcpdStatusText}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           Margin="0,0,0,8"
                                           Text="将 SetUserFTA.exe 放入程序目录 Tools\（setuserfta.com 个人版）。" />
                                <Button Content="禁用 UCPD（需重启）"
                                        HorizontalAlignment="Left"
                                        Style="{DynamicResource GhostButton}"
                                        Command="{Binding DisableUcpdCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- 手动路径 -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="手动路径"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="主列表「指定路径」可添加"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Opacity="0.85"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Background="{DynamicResource BrushBgElevated}"
                                CornerRadius="8"
                                Padding="4"
                                MinHeight="72">
                            <Grid>
                                <!-- 空状态 -->
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="12">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ManualPathEntries.Count}"
                                                             Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="暂无手动路径"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               Text="在主界面为浏览器点「指定路径」后，会显示在这里。"
                                               TextWrapping="Wrap"
                                               MaxWidth="320" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding ManualPathEntries}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ManualPathEntries.Count}"
                                                             Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,8"
                                                    BorderBrush="{DynamicResource BrushLineSubtle}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="108" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextPrimary}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,8,0" />
                                                    <TextBox Grid.Column="1"
                                                             Padding="6,4"
                                                             FontSize="12"
                                                             VerticalContentAlignment="Center"
                                                             Text="{Binding Path=Path,
                                                                UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="2"
                                                            Content="移除"
                                                            Margin="8,0,0,0"
                                                            Padding="10,4"
                                                            FontSize="12"
                                                            Style="{DynamicResource GhostButton}"
                                                            Command="{Binding DataContext.RemoveManualPathCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
